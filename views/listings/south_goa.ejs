<% layout("/layouts/boilerplate") %>
<section class="tour-hero-section">
    <!-- Blue-Teal Gradient Overlay -->
    <div class="tour-overlay"></div>
    
    <!-- Main Content Container -->
    <div class="tour-content-container">
        <span class="tour-subtitle">HERITAGE & BEACHES</span>
        <h1 class="tour-title">South Goa Tour</h1>
        <p class="tour-desc">
            Discover the serene beauty of South Goa. From UNESCO heritage churches to pristine beaches, experience the quieter, more authentic side of Goa.
        </p>

        <!-- Information Boxes -->
        <div class="tour-info-boxes">
            
            <!-- Box 1: Duration -->
            <div class="info-box">
                <span class="info-label">Duration</span>
                <div class="info-value">
                    <!-- Clock SVG Icon -->
                    <svg class="icon-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    10-11 Hours
                </div>
            </div>

            <!-- Box 2: Fare -->
            <div class="info-box">
                <span class="info-label">Full day tour</span>
                <div class="info-value">
                    Contact us for fare
                </div>
            </div>

        </div>
    </div>
</section>



<section class="tour-layout-section">
    <div class="tour-layout-container">
        
        <!-- LEFT COLUMN: Content -->
        <div class="tour-content">
            
            <!-- Section 1 -->
            <h2>South Goa Tour Stops</h2>
            <p class="subtitle">This full-day tour covers heritage, temples, beaches, and a boat cruise.</p>
            <ul class="chevron-list">
                <li>Old Goa Church & Museum</li>
                <li>Mangeshi Temple</li>
                <li>Shri Balaji Temple</li>
                <li>Spice Plantation</li>
                <li>Dona Paula</li>
                <li>Miramar Beach</li>
                <li>Fountain house</li>
                <li>Boat Cruise</li>
            </ul>

            <!-- Section 2 -->
            <h2>South Goa Special Beaches Route</h2>
            <p class="subtitle">Optional extended coastal route that can be done as a separate day tour.</p>
            <ol class="blue-numbers-list">
                <li>Cabo De Rama Beach</li>
                <li>Cabo De Rama Fort View Point</li>
                <li>Butterfly Beach</li>
                <li>Palolem Beach</li>
                <li>Agonda Beach</li>
                <li>Colva Beach</li>
                <li>Cola Beach</li>
            </ol>

            <!-- Section 3: Tour Highlights (Updated) -->
            <h2>Tour Highlights</h2>
            <p class="subtitle">This is a suggested plan. You can always change the stops or create your own route with the driver on the day.</p>

            <div class="highlights-cards-container">
                
                <!-- Highlight Card 1 -->
                <div class="highlight-card">
                    <div class="hl-icon">
                        <!-- Building/Heritage SVG -->
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 21h18"></path><path d="M5 21V9l7-6 7 6v12"></path><path d="M9 21v-4a3 3 0 0 1 6 0v4"></path>
                        </svg>
                    </div>
                    <div class="hl-text">
                        <h4>Old Goa Heritage</h4>
                        <p>Old Goa Church & Museum with iconic architecture.</p>
                    </div>
                </div>

                <!-- Highlight Card 2 -->
                <div class="highlight-card">
                    <div class="hl-icon">
                        <!-- Tree/Nature SVG -->
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22V13"></path><path d="M12 13a4 4 0 0 1 4-4v0a4 4 0 0 1-4 4Z"></path><path d="M12 13a4 4 0 0 0-4-4v0a4 4 0 0 0 4 4Z"></path><path d="M12 9a4 4 0 0 1 4-4v0a4 4 0 0 1-4 4Z"></path><path d="M12 9a4 4 0 0 0-4-4v0a4 4 0 0 0 4 4Z"></path><path d="M12 5a4 4 0 0 1 4-4v0a4 4 0 0 1-4 4Z"></path><path d="M12 5a4 4 0 0 0-4-4v0a4 4 0 0 0 4 4Z"></path>
                        </svg>
                    </div>
                    <div class="hl-text">
                        <h4>Temple Visit</h4>
                        <p>Mangeshi Temple and Shri Balaji Temple.</p>
                    </div>
                </div>

                <!-- Highlight Card 3 -->
                <div class="highlight-card">
                    <div class="hl-icon">
                        <!-- Waves SVG -->
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 6c.6.5 1.2 1 2.5 1 1.5 0 2-.5 2.5-1 .6-.5 1.2-1 2.5-1 1.5 0 2 .5 2.5 1 .6.5 1.2 1 2.5 1 1.5 0 2-.5 2.5-1"></path>
                            <path d="M2 12c.6.5 1.2 1 2.5 1 1.5 0 2-.5 2.5-1 .6-.5 1.2-1 2.5-1 1.5 0 2 .5 2.5 1 .6.5 1.2 1 2.5 1 1.5 0 2-.5 2.5-1"></path>
                            <path d="M2 18c.6.5 1.2 1 2.5 1 1.5 0 2-.5 2.5-1 .6-.5 1.2-1 2.5-1 1.5 0 2 .5 2.5 1 .6.5 1.2 1 2.5 1 1.5 0 2-.5 2.5-1"></path>
                        </svg>
                    </div>
                    <div class="hl-text">
                        <h4>Coastal Views</h4>
                        <p>Dona Paula, Miramar Beach, and Fountain house.</p>
                    </div>
                </div>

                <!-- Highlight Card 4 -->
                <div class="highlight-card">
                    <div class="hl-icon">
                        <!-- Camera SVG -->
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                            <circle cx="12" cy="13" r="4"></circle>
                        </svg>
                    </div>
                    <div class="hl-text">
                        <h4>Spice & Cruise</h4>
                        <p>Spice plantation tour with a relaxing boat cruise.</p>
                    </div>
                </div>

            </div>
            <!-- Section 4: Day Plan Timeline -->
            <h2 class="timeline-heading">Sample Day Plan (Fully Flexible)</h2>

            <div class="day-plan-timeline">
                <!-- Connecting Vertical Line -->
                <div class="timeline-line"></div>

                <!-- Stop 1 -->
                <div class="timeline-item">
                    <div class="timeline-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div class="timeline-content">
                        <span class="time">8:30 AM</span>
                        <span class="activity">Pickup from your hotel</span>
                    </div>
                </div>

                <!-- Stop 2 -->
                <div class="timeline-item">
                    <div class="timeline-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div class="timeline-content">
                        <span class="time">9:30 AM</span>
                        <span class="activity">Old Goa Church & Museum</span>
                    </div>
                </div>

                <!-- Stop 3 -->
                <div class="timeline-item">
                    <div class="timeline-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div class="timeline-content">
                        <span class="time">10:30 AM</span>
                        <span class="activity">Mangueshi Temple</span>
                    </div>
                </div>

                <!-- Stop 4 -->
                <div class="timeline-item">
                    <div class="timeline-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div class="timeline-content">
                        <span class="time">11:30 AM</span>
                        <span class="activity">Shri Balaji Temple</span>
                    </div>
                </div>

                <!-- Stop 5 -->
                <div class="timeline-item">
                    <div class="timeline-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div class="timeline-content">
                        <span class="time">12:30 PM</span>
                        <span class="activity">Spice Plantation</span>
                    </div>
                </div>

                <!-- Stop 6 -->
                <div class="timeline-item">
                    <div class="timeline-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div class="timeline-content">
                        <span class="time">2:30 PM</span>
                        <span class="activity">Dona Paula</span>
                    </div>
                </div>

                <!-- Stop 7 -->
                <div class="timeline-item">
                    <div class="timeline-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div class="timeline-content">
                        <span class="time">3:30 PM</span>
                        <span class="activity">Miramar Beach</span>
                    </div>
                </div>

                <!-- Stop 8 -->
                <div class="timeline-item">
                    <div class="timeline-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div class="timeline-content">
                        <span class="time">4:30 PM</span>
                        <span class="activity">Fountain house</span>
                    </div>
                </div>

                <!-- Stop 9 -->
                <div class="timeline-item">
                    <div class="timeline-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div class="timeline-content">
                        <span class="time">5:30 PM</span>
                        <span class="activity">Boat Cruise</span>
                    </div>
                </div>

                <!-- Stop 10 -->
                <div class="timeline-item">
                    <div class="timeline-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div class="timeline-content">
                        <span class="time">7:30 PM</span>
                        <span class="activity">Drop back to hotel</span>
                    </div>
                </div>
            </div>


            <!-- Section 5: What's Included -->
            <div class="whats-included-box">
                <h3 class="included-title">What's Included</h3>
                <ul class="included-list">
                    <li>
                        <!-- Green Check Circle Icon -->
                        <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        AC vehicle (Sedan/SUV based on booking)
                    </li>
                    <li>
                        <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        Experienced local driver guide
                    </li>
                    <li>
                        <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        Hotel pickup and drop
                    </li>
                    <li>
                        <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        Spice plantation entry with lunch
                    </li>
                    <li>
                        <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        Toll and parking charges
                    </li>
                    <li>
                        <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        Driver allowance
                    </li>
                    <li>
                        <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        Water bottles
                    </li>
                </ul>
            </div>

        </div>

        <!-- RIGHT COLUMN: Sticky Sidebar Form -->
        <div class="tour-sidebar">
            <div class="booking-card">
                <div class="booking-header">
                    <h3>Book South Goa Tour</h3>
                    <p>Fill in the details below. Send your booking via WhatsApp or Email and we'll confirm shortly.</p>
                </div>

                <form class="booking-form-inner">
                    <!-- Row 1 -->
                    <div class="form-row">
                        <div class="input-group">
                            <label>Full Name</label>
                            <input type="text" placeholder="Your name" id="name">
                        </div>
                        <div class="input-group">
                            <label>Phone Number</label>
                            <input type="tel" placeholder="+91 96321 90350" id="number">
                        </div>
                    </div>

                    <!-- Row 2 -->
                    <div class="input-group">
                        <label>Email (optional, for booking confirmation)</label>
                        <input type="email" placeholder="your@email.com" id="email">
                    </div>

                    <!-- Row 3 -->
                    <div class="form-row">
                        <div class="input-group">
                            <label>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                Pickup Location
                            </label>
                            <input type="text" placeholder="Enter pickup location" id="pickup">
                        </div>
                        <div class="input-group">
                            <label>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                Date
                            </label>
                            <input type="date" id="date">
                        </div>
                    </div>

                    <!-- Row 4 -->
                    <div class="form-row">
                        <div class="input-group">
                            <label>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                Time
                            </label>
                            <input type="time" id="time">
                        </div>
                        <div class="input-group">
                            <label>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                                Passengers
                            </label>
                            <select id="passanger">
                                <option>2 Passengers</option>
                                <option>3 Passengers</option>
                                <option>4 Passengers</option>
                                <option>5+ Passengers</option>
                            </select>
                        </div>
                    </div>

                    <!-- Row 5 (Half Width) -->
                    <div class="form-row">
                        <div class="input-group">
                            <label>Vehicle Type</label>
                            <select id="vehicle">
                                <option>Sedan (4 Seater)</option>
                                <option>SUV (6 Seater)</option>
                                <option>Premium SUV</option>
                            </select>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="form-actions">
                        <button type="button" class="btn-wa" onclick="northBookNow(event)">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
                            Book via WhatsApp
                        </button>
                        <button type="button" class="btn-email" onclick="northBookNowOnEmail(event)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            Send via Email
                        </button>
                    </div>

                    <!-- Footer Link -->
                    <div class="form-footer">
                        Or call us at <a href="tel:+919632190350">+91 96321 90350</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</section>