<% layout("/layouts/boilerplate") %>
<div class="services-header-banner">
    <div class="banner-content">
        <span class="subtitle">WHAT WE OFFER</span>
        <h1 class="main-title">Services</h1>
        <p class="descriptiona">
            Taxi booking, airport transfers, North and South Goa sightseeing, and group trips. Choose a service below.
        </p>
    </div>
</div>

<section class="services-container">
  <div class="services-grid">
    
    <!-- Card 1: Local Sightseeing -->
    <div class="service-card">
      <div class="service-icon">
        <!-- Map Pin Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#25a5d8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </div>
      <div class="service-details">
        <h3>Local Sightseeing</h3>
        <p>Full-day North Goa tour: Fort Aguada, dolphin trip, Calangute, Baga, Anjuna, Vagator and more. AC vehicle, experienced driver.</p>
        <a href="/listings/north-goa" class="service-link">View North Goa Tour &rarr;</a>
      </div>
    </div>

    <!-- Card 2: Airport Transfers -->
    <div class="service-card">
      <div class="service-icon">
        <!-- Plane Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#25a5d8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3.5c-.5-.5-2.5 0-4 1.5L13.5 8.5 5.3 6.7c-.5-.1-1 .1-1.3.5l-.8.8c-.3.3-.3.9 0 1.2l5.2 5.2-3.4 3.4-2.3-.6c-.3-.1-.7 0-.9.3l-.4.4c-.2.2-.2.6 0 .8l2.6 2.6c.2.2.6.2.8 0l.4-.4c.3-.2.4-.6.3-.9l-.6-2.3 3.4-3.4 5.2 5.2c.3.3.9.3 1.2 0l.8-.8c.4-.3.6-.8.5-1.3z"/></svg>
      </div>
      <div class="service-details">
        <h3>Airport Transfers</h3>
        <p>Dabolim and Mopa airport pickup and drop. Flight tracking, meet & greet, fixed routes. Sedan to Innova and Tempo Traveller.</p>
        <a href="/listings/airport" class="service-link">View Airport Pickup &rarr;</a>
      </div>
    </div>

    <!-- Card 3: Outstation Tours -->
    <div class="service-card">
      <div class="service-icon">
        <!-- Map Pin Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#25a5d8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </div>
      <div class="service-details">
        <h3>Outstation Tours</h3>
        <p>South Goa sightseeing: Old Goa churches, Mangueshi Temple, Dona Paula, Miramar, spice plantation and boat cruise. Full day with lunch.</p>
        <a href="/listings/south-goa" class="service-link">View South Goa Tour &rarr;</a>
      </div>
    </div>

    <!-- Card 4: Group Trips -->
    <div class="service-card">
      <div class="service-icon">
        <!-- Users Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#25a5d8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <div class="service-details">
        <h3>Group Trips</h3>
        <p>Tempo Traveller and multi-vehicle arrangements for groups. Corporate outings, family trips, and flexible itineraries across Goa.</p>
        <a href="/listings/fleet" class="service-link">View Our Fleet &rarr;</a>
      </div>
    </div>

    <!-- Card 5: Custom Tours -->
    <div class="service-card">
      <div class="service-icon">
        <!-- Map Pin Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#25a5d8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </div>
      <div class="service-details">
        <h3>Custom Tours</h3>
        <p>No fixed itinerary – book a driver for a set number of hours and choose your own attractions like Old Goa and Mangueshi Temple.</p>
        <a href="/listings/custom" class="service-link">View Custom Tours &rarr;</a>
      </div>
    </div>

  </div>
</section>



<section class="custom-inquiry-section">
  <p class="inquiry-text">Need a custom itinerary or have questions?</p>
  
  <div class="inquiry-buttons">
    <a href="/listings/booknow" class="btns btn-orange">Book Now</a>
    <a href="/listings/contact" class="btns btn-light-outline">Contact Us</a>
  </div>
</section>