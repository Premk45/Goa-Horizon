<% layout("/layouts/boilerplate") %>

<div class="container my-4 booking-form newform">
  <h2>Add New Package</h2>
  
  <form action="/listings" 
        method="POST" 
        enctype="multipart/form-data" 
        class="package-form "
    >
    
    <!-- Image Upload -->
    <div class="form-group mb-3 ">
      <label for="image" class="form-label newlable">Image:</label>
      <input 
        type="file" 
        class="form-control"
        id="Image" 
        name="listing[Image]" 
        accept="image/*" 
        required
      />
    </div>

    <!-- Title -->
    <div class="form-group mb-3">
      <label for="title" class="form-label newlable">Title:</label>
      <input 
        name="listing[Title]"
        type="text" 
        class="form-control"
        id="Title" 
        placeholder="Enter package title" 
        value="<%= typeof title !== 'undefined' ? title : '' %>" 
        required
      />
    </div>

    <!-- Description -->
    <div class="form-group mb-3">
      <label for="description" class="form-label newlable">Description:</label>
      <textarea 
        class="form-control"
        id="Description" 
        name="listing[Description]" 
        rows="4" 
        placeholder="Enter description..." 
        required
      ><%= typeof description !== 'undefined' ? description : '' %></textarea>
    </div>

    <!-- Package Type -->
    <div class="form-group mb-3">
      <label for="description" class="form-label newlable">Package Type:</label>
      <textarea 
        class="form-control"
        id="Package_Type" 
        name="listing[Package_Type]" 
        rows="4" 
        placeholder="Enter Package_Type..." 
        required
      ><%= typeof description !== 'undefined' ? description : '' %></textarea>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="btn btn-primary">Submit Package</button>

  </form>
</div>