<% layout("/layouts/boilerplate") %>

<!-- === HERO SECTION === -->
<section class="goa-hero-banner railway">
    <div class="goa-hero-overlay"></div>
    <div class="goa-wrap-container">
        <div class="goa-hero-content">
            <span class="goa-badge-text">FULL DAY TOUR</span>
            <h1 class="goa-main-title">Railway Station</h1>
            <p class="goa-main-desc">Experience the High quality service of Railway Station pickup and drop service.</p>
            
            <div class="goa-info-cards-row">
                <div class="goa-info-box">
                    <span class="goa-info-title">Duration</span>
                    <span class="goa-info-value">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        8-9 Hours
                    </span>
                </div>
                <div class="goa-info-box">
                    <span class="goa-info-title">Full day Service</span>
                    <span class="goa-info-value">Contact us for fare</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- === MAIN PAGE CONTENT (TWO COLUMNS) === -->
<section class="goa-page-content goa-wrap-container">
    
    <!-- LEFT SIDE (Scrollable Content) -->
    <div class="goa-left-details">
        

        <!-- 2. Beach Route -->
        <div class="goa-section-block">
            <h2 class="goa-block-heading">Railway Stations</h2>
            <p class="goa-block-subtext">Railway Stations Which We Are Giving Service for pickup and drop. High Quality Service </p>
            <ol class="goa-numbered-list">
                <li>Madgaon Railway Station</li>
                <li>Thivim Railway Station</li>
                <li>Vasco Da Gama Railway Station</li>
                <li>Karmali Railway Station</li>
            </ol>
        </div>


        <h2>Railway Stations</h2>

        <!-- Wrapper Div jisme overflow hidden hai aur aapka 3D style hai -->
        <div style="width: 100%; height: 400px; overflow: hidden; border-radius:  12px; box-shadow: 0px 10px 25px rgba(0,0,0,0.4), 0px 4px 10px rgba(0,0,0,0.2);">
            
            <!-- Aapka Iframe, jisme humne margin-top -60px kar diya hai -->
            <iframe 
                src="https://www.google.com/maps/d/embed?mid=1rQH9RSDw1_0AvuZIgwly7Xc3Nilkwrw&ehbc=2E312F" 
                width="100%" 
                height="460" 
                style="border: 0; margin-top: -60px;" 
                loading="lazy">
            </iframe>

        </div>

        <br>





        <!-- 4. What's Included -->
        <div class="goa-included-container">
            <h3 class="goa-included-heading">What's included</h3>
            <ul class="goa-included-list">
                <li><svg class="goa-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> AC vehicle (Sedan/SUV based on booking)</li>
                <li><svg class="goa-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Experienced local driver guide</li>
                <li><svg class="goa-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Hotel pickup and drop</li>
                <li><svg class="goa-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Toll and parking charges</li>
                <li><svg class="goa-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Driver allowance</li>
                <li><svg class="goa-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Water bottles</li>
            </ul>
        </div>

    </div>

    <!-- RIGHT SIDE (Sticky Form) -->
    <div class="goa-right-form-area">
        <!-- YE WALA DIV STICKY HAI -->
        <div class="goa-booking-card-sticky">
            
            <div class="goa-form-head">
                <h3>Book Service</h3>
                <p>Fill in the details below. Send your booking via WhatsApp or Email and we'll confirm shortly.</p>
            </div>
            
            <form class="goa-actual-form">
                <div class="goa-form-grid-2">
                    <div class="goa-input-wrapper">
                        <label>Full Name</label>
                        <input type="text" placeholder="Your name" id="name" required>
                    </div>
                    <div class="goa-input-wrapper">
                        <label>Phone Number</label>
                        <input type="tel" placeholder="+91 96321 90350" id="number" required>
                    </div>
                </div>
                
                <div class="goa-input-wrapper">
                    <label>Email (optional, for booking confirmation)</label>
                    <input type="email" placeholder="your@email.com" id="email">
                </div>

                <div class="goa-form-grid-2">
                    <div class="goa-input-wrapper">
                        <label><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> Pickup Location</label>
                        <input type="text" placeholder="Enter pickup location" id="pickup">
                    </div>
                    <div class="goa-input-wrapper">
                        <label><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg> Date</label>
                        <input type="date" id="date" required>
                    </div>
                </div>

                <div class="goa-form-grid-2">
                    <div class="goa-input-wrapper">
                        <label><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> Time</label>
                        <input type="time" id="time">
                    </div>
                    <div class="goa-input-wrapper">
                        <label><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg> Passengers</label>
                        <select id="passanger" required>
                            <option>2 Passengers</option>
                            <option>4 Passengers</option>
                        </select>
                    </div>
                </div>

                <div class="goa-input-wrapper" style="width: 50%;">
                    <label>Vehicle Type</label>
                    <select id="vehicle" required>
                        <option>Sedan (4 Seater)</option>
                        <option>SUV (6 Seater)</option>
                    </select>
                </div>

                <div class="goa-form-buttons">
                    <button type="button" class="goa-btn-whatsapp" onclick="northBookNow(event)">Book via WhatsApp</button>
                    <button type="button" class="goa-btn-email" onclick="northBookNowOnEmail(event)">Send via Email</button>
                </div>
                
                <p class="goa-form-foot-note">Or call us at <a href="tel:+919632190350">+91 96321 90350</a></p>
            </form>
        </div>
    </div>
</section>