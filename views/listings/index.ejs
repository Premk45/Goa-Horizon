<% layout("/layouts/boilerplate.ejs") %>

<!-- Video And Form -->
<div class="hero-container">
    <!-- वीडियो टैग (सारे एट्रीब्यूट्स क्लास से बाहर निकाल दिए गए हैं) -->
    <video id="my-video" class="bg-video" preload="auto" autoplay loop muted playsinline>
        <source src="/videos/Beach_Sea.mp4" type="video/mp4" />
        Your browser does not support the video tag.
    </video>

    <div class="video-overlay"></div>

    <div class="content-wrapper">
        <span class="sub-heading">YOUR GOA TRAVEL PARTNER</span>
        <h1 class="main-headingv">Discover the magic <br><span>of Goa</span></h1>
        <p class="descriptionp">Comfortable rides, trusted drivers, and full-day North & South Goa tours — book in minutes on WhatsApp.</p>

        <!-- Form me onsubmit event add kiya gaya hai -->
        <form class="booking-form" onsubmit="sendToWhatsApp(event)">
            <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" placeholder="Your name" required>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="phone">Phone / WhatsApp</label>
                    <input type="tel" id="phone" placeholder="+91 ..." required>
                </div>
                <div class="form-group">
                    <label for="date">Travel date</label>
                    <input type="date" id="date" required>
                </div>
            </div>

            <div class="form-group">
                <label for="guests">Guests</label>
                <select id="guests">
                    <option value="1">1 Person</option>
                    <option value="2">2 Persons</option>
                    <option value="3">3-5 Persons</option>
                    <option value="6">6+ Persons</option>
                </select>
            </div>

            <div class="form-group">
                <label for="service">Service</label>
                <select id="service">
                    <option value="north-south">North & South Goa Sightseeing</option>
                    <option value="north">North Goa Tour Only</option>
                    <option value="south">South Goa Tour Only</option>
                </select>
            </div>

            <button type="submit" class="submit-btn" onclick="sendToWhatsApp(event)">Get details on WhatsApp</button>
        </form>
    </div>

    <section class="stats-section">
        <div class="stats-container">
            
            <div class="stat-item">
                <h2 class="stat-number color-yellow">10,000<sup>+</sup></h2>
                <p class="stat-label">Happy riders</p>
            </div>

            <div class="stat-item">
                <h2 class="stat-number">4.9 <span class="star-icon">★</span></h2>
                <p class="stat-label">Average rating</p>
            </div>

            <div class="stat-item">
                <h2 class="stat-number">AC</h2>
                <p class="stat-label">Fleet</p>
            </div>

            <div class="stat-item">
                <h2 class="stat-number">24/7</h2>
                <p class="stat-label">WhatsApp</p>
            </div>

        </div>
    </section>


</div>

<!-- SECTION 1: QUICK ACCESS TAGS -->
<section class="quick-access-section">
    <h3 class="section-title">QUICK ACCESS</h3>
    <div class="tags-container">
        <a href="/listings/north-goa" class="tag-btn">North Goa Tour</a>
        <a href="/listings/south-goa" class="tag-btn">South Goa Tour</a>
        <a href="/listings/airport" class="tag-btn">Airport Pickup</a>
        <a href="/listings/booknow" class="tag-btn">Taxi Booking</a>
        <a href="/listings/fleet"  class="tag-btn">Our Fleet</a>
        <a href="#dudhsagar-details" class="tag-btn">Dudhsagar</a>
        <a href="/listings/custom"  class="tag-btn">Custom Tour</a>
        <a href="/listings/review" class="tag-btn">Reviews</a>
    </div>
</section>

<hr class="section-divider">


<!-- SECTION 2: INFO CARD SECTION -->
<section class="info-card-section">
    <div class="temple-container">
        
        <!-- Left Side: Image Card with Shadow & Border Radius -->
        <div class="image-card">
            <!-- Apni image ka path yahan dalein -->
            <img src="/images/temple.jpg" alt="Goa Temple">
        </div>

        <!-- Right Side: Content Details -->
        <div class="content-side">
            <span class="sub-title">GOA TRAVEL EXPERTS</span>
            <h2 class="main-heading">Your trusted partner on the road</h2>
            <p class="description">
                From first airport pickup to your last sunset drive, we focus on one thing: making your Goa trip easy. Local drivers, clean AC vehicles, and itineraries you can actually change on the day.
            </p>

            <!-- Features List -->
            <ul class="features-list">
                <li>
                    <span class="icon">🛡️</span> 
                    Goa-based team with route know-how
                </li>
                <li>
                    <span class="icon">🛡️</span> 
                    Best-value quotes for the vehicle class you need
                </li>
                <li>
                    <span class="icon">🛡️</span> 
                    Verified, experienced drivers
                </li>
                <li>
                    <span class="icon">🛡️</span> 
                    WhatsApp booking in minutes
                </li>
            </ul>

            <!-- Action Buttons -->
            <div class="btn-group">
                <a href="/listings/contact"  class="btn btn-primary">Get in touch</a>
                <a href="/listings/about" class="btn btn-secondary">About us</a>
            </div>
        </div>

    </div>
</section>


<div class="parent-container">
    <% for(let listing of allListings){ %>   
    <div class="t-card">
        <div class="card-image-area images">
            <span class="badge-popular">Popular</span>
            <img class="images" src="<%= listing.Image.url %>" alt="listing image">
        </div>
        
        <div class="card-body">
            <h3 class="card-title"><%= listing.Title %></h3>
            <p class="card-description">
                <%= listing.Description %>
            </p>
            <div class="card-rate-info"> 
                <%= listing.Package_Type %> 
            </div>
            
            <div class="card-actions">
                <% if (listing.Title === 'Goa Airport Pickup & Drop') { %>
                    <a href="/listings/airport" class="btn btn-view">View details</a>
        
                <% } else if (listing.Title === 'Create Your Own Goa Tour') { %>
                    <a href="/listings/custom" class="btn btn-view">View details</a>
                    
                <% } else if (listing.Title === 'Tempo & Group Travel') { %>
                    <a href="/listings/fleet" class="btn btn-view">View details</a>

                <% } else if (listing.Title === 'South Goa Tour') { %>
                    <a href="/listings/south-goa" class="btn btn-view">View details</a>

                <% } else if (listing.Title === 'North Goa Tour') { %>
                    <a href="/listings/north-goa" class="btn btn-view">View details</a>    

                <% } else { %>
                    <a href="/listings/<%= listing._id %>" class="btn btn-view">View details</a>
                    
                <% } %>
                <a class="btn btn-book" 
                    onclick="bookSingleService('<%= listing.Title %>')">
                    Book now
                </a>
            </div>
        </div>
    </div>
    <% } %>
</div>



