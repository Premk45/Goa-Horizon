<% layout("/layouts/boilerplate.ejs") %>
<div class="services-header-banner contactb">
    <div class="banner-content">
        <span class="subtitle">WE ARE HERE TO HELP</span>
        <h1 class="main-title">CONTACT US</h1>
        <p class="descriptiona">
            Have questions? Need a custom quote? Reach out by phone, email, or WhatsApp. We're here 24/7.
        </p>
    </div>
</div>




<section class="contact-section">
    <div class="contact-grid">
        
        <!-- Left Column: Contact Information -->
        <div class="contact-info">
            <h2 class="section-title">Contact Information</h2>
            
            <!-- Phone Card -->
            <div class="info-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                </div>
                <div class="info-text">
                    <h4>Phone</h4>
                    <p>+91 96321 90350</p>
                </div>
            </div>

            <!-- Email Card -->
            <div class="info-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                </div>
                <div class="info-text">
                    <h4>Email</h4>
                    <p>sachinchavan9632@gmail.com</p>
                </div>
            </div>

            <!-- Working Hours Card -->
            <div class="info-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
                <div class="info-text">
                    <h4>Working Hours</h4>
                    <p>24/7 Service Available<br>Office: 9 AM - 9 PM</p>
                </div>
            </div>

            <!-- Prefer WhatsApp Box -->
            <div class="whatsapp-box">
                <h4>Prefer WhatsApp?</h4>
                <p>Get instant responses on WhatsApp. Click below to start a conversation.</p>
                <a href="#" class="btn-whatsapp" onclick="bookSingleService(`I'd like to know more about your services.`)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                    Chat on WhatsApp
                </a>
            </div>
        </div>

        <!-- Right Column: Form -->
        <div class="contact-form-container">
            <h2 class="section-title">Send Us a Message</h2>
            <p class="form-subtitle">Fill out the form and we'll get back to you within 1 hour.</p>
            
            <form>
                <div class="form-row">
                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" placeholder="Your name" id="name">
                    </div>
                    <div class="form-group">
                        <label>Phone Number</label>
                        <input type="tel" placeholder="+91 96321 90350" id="number">
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" placeholder="your@email.com" id="mail">
                </div>
                
                <div class="form-group">
                    <label>Subject</label>
                    <input type="text" placeholder="How can we help?" id="sub">
                </div>
                
                <div class="form-group">
                    <label>Message</label>
                    <textarea placeholder="Tell us more about your requirements..." id="msg"></textarea>
                </div>
                
                <button type="submit" class="btn-submit" onclick="sendToWhatsAppC(event)"  >
                    Send Message via WhatsApp
                </button>
            </form>
        </div>

    </div>
</section>