<% layout("/layouts/boilerplate.ejs") %>
<section class="reviews-sectionr">
    <!-- Blue Overlay -->
    <div class="reviews-overlay"></div>
    
    <!-- Main Content -->
    <div class="reviews-content">
        <div class="reviews-header">
            <span class="subtitle">TESTIMONIALS</span>
            <div class="stars">
                &#9733; &#9733; &#9733; &#9733; &#9733;
            </div>
            <h2>Customer Reviews</h2>
            <p>Don't just take our word for it. Here's what our happy customers say about their Goa Horizon Travels experience.</p>
        </div>

        <div class="stats-container">
            <div class="stat-box">
                <h3>10,000+</h3>
                <p>Happy Customers</p>
            </div>
            <div class="stat-box">
                <h3>4.9&#9733;</h3>
                <p>Average Rating</p>
            </div>
            <div class="stat-box">
                <h3>98%</h3>
                <p>5-Star Reviews</p>
            </div>
            <div class="stat-box">
                <h3>50+</h3>
                <p>Expert Drivers</p>
            </div>
        </div>
    </div>
</section>





<!-- Main Two-Column Container -->
<div class="review-layout-wrapper">
  

    <!-- Right Column: 3D QR Code -->
  <div class="qr-wrapper">
    <div class="qr-title-container">
      <h2 class="qr-heading">Do QR Or Form</h2>
    </div>
    <img class="qr_code qr-image" src="/images/QR.png" alt="Scan QR Code">
  </div>



  <!-- Left Column: Form Section -->
  <div class="rform-container">
    <div class="rform-card">
      <h4 class="rform-title">Share Your Experience</h4>
      <form action="/listings/review" method="POST">
        <div class="rform-grid">
          <div class="rform-col-6">
            <input type="text" name="name" class="rform-input" placeholder="Your Name" required>
          </div>
          <div class="rform-col-6">
            <input type="text" name="location" class="rform-input" placeholder="City, Country" required>
          </div>
          
          <div class="rform-col-12">
            <input type="text" name="tour" class="rform-input" placeholder="Tour Category (e.g. Sightseeing Tour)" required>
          </div>

          <div class="rform-col-12">
            <select name="rating" class="rform-select" required>
              <option value="5" selected>⭐⭐⭐⭐⭐ (5/5)</option>
              <option value="4">⭐⭐⭐⭐ (4/5)</option>
              <option value="3">⭐⭐⭐ (3/5)</option>
              <option value="2">⭐⭐ (2/5)</option>
              <option value="1">⭐ (1/5)</option>
            </select>
          </div>
          <div class="rform-col-12">
            <textarea name="comment" class="rform-textarea" rows="3" placeholder="Write your review here..." required></textarea>
          </div>
          <div class="rform-col-12">
            <button type="submit" class="rform-btn-submit">Submit Review</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  

</div>




<hr class="qr-divider">
<h2 class="qr_head">Costomers Valuable Reviews.</h2>


<!-- Dynamic Reviews Display Section -->
<div class="rform-reviews-container">
  <div class="rform-reviews-grid">
    <% reviews.forEach(review => { %>
      <div class="rform-review-col">
        <div class="rform-review-card">
          <!-- Rating Stars -->
          <div class="rform-stars">
            <%= '★'.repeat(review.rating) %><%= '☆'.repeat(5 - review.rating) %>
          </div>
          
          <!-- Comment -->
          <p class="rform-comment">"<%= review.comment %>"</p>
          
          <!-- User Profile Section -->
            <div class="rform-user-profile">
            <div class="rform-avatar">
                <%= (review.name && review.name.length > 0) ? review.name.charAt(0).toUpperCase() : 'U' %>
            </div>
            <div>
                <h6 class="rform-user-name"><%= review.name || 'Anonymous User' %></h6>
                <small class="rform-user-location"><%= review.location || 'N/A' %></small>
            </div>
            </div>

            <!-- Sightseeing Tour Pill Badge -->
            <div>
            <span class="rform-tour-tag"><%= review.tour %></span>
            </div>

        </div>
      </div>
    <% }) %>
  </div>
</div>







