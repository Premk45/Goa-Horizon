<% layout("/layouts/boilerplate.ejs") %>
<section class="reviews-sectionr">
    <!-- Blue Overlay -->
    <div class="reviews-overlay"></div>
    
    <!-- Main Content -->
    <div class="reviews-content">
        <div class="reviews-header">
            <span class="subtitle">TESTIMONIALS</span>
            <div class="stars">
                &#9733; &#9733; &#9733; &#9733; &#9733;
            </div>
            <h2>Customer Reviews</h2>
            <p>Don't just take our word for it. Here's what our happy customers say about their Goa Horizon Travels experience.</p>
        </div>

        <div class="stats-container">
            <div class="stat-box">
                <h3>10,000+</h3>
                <p>Happy Customers</p>
            </div>
            <div class="stat-box">
                <h3>4.9&#9733;</h3>
                <p>Average Rating</p>
            </div>
            <div class="stat-box">
                <h3>98%</h3>
                <p>5-Star Reviews</p>
            </div>
            <div class="stat-box">
                <h3>50+</h3>
                <p>Expert Drivers</p>
            </div>
        </div>
    </div>
</section>



<div class="reviews-grid">
    <!-- Card 1 -->
    <div class="review-card">
        <div class="stars">★★★★★</div>
        <p class="review-text">"Highly recommend Goa Horizon Travels! We booked a Swift Dzire for airport transfers and a 3-day sightseeing tour. The driver was incredibly polite and knew all the best local spots. The car was spotless every single morning. The WhatsApp booking was seamless."</p>
        <div class="user-info">
            <div class="avatar" style="background-color: #f99b28;">S</div>
            <div class="user-details">
                <span class="user-name">Sarah Jenkins</span>
                <span class="user-location">London, UK</span>
            </div>
        </div>
        <hr class="divider">
        <div class="tag">Sightseeing Tour</div>
    </div>

    <!-- Card 2 -->
    <div class="review-card">
        <div class="stars">★★★★<span class="empty-star">★</span></div>
        <p class="review-text">"Very reliable service for our trip to South Goa. Booking through WhatsApp was a breeze. The only minor issue was the AC in our first car wasn't cooling perfectly, but they swapped the vehicle the next day without any fuss. Good experience."</p>
        <div class="user-info">
            <div class="avatar" style="background-color: #f99b28;">A</div>
            <div class="user-details">
                <span class="user-name">Amit Patel</span>
                <span class="user-location">Mumbai, India</span>
            </div>
        </div>
        <hr class="divider">
        <div class="tag">Taxi Booking</div>
    </div>

    <!-- Card 3 -->
    <div class="review-card">
        <div class="stars">★★★★★</div>
        <p class="review-text">"Traveled with my elderly parents and couldn't have asked for a better experience. The Innova Crysta was very comfortable for them to get in and out of. The driver was exceptionally patient and drove very safely on the narrow Goan roads."</p>
        <div class="user-info">
            <div class="avatar" style="background-color: #f99b28;">P</div>
            <div class="user-details">
                <span class="user-name">Priya Sharma</span>
                <span class="user-location">Delhi, India</span>
            </div>
        </div>
        <hr class="divider">
        <div class="tag">Family Trip</div>
    </div>

    <!-- Card 4 -->
    <div class="review-card">
        <div class="stars">★★★★★</div>
        <p class="review-text">"We hired a 12-seater Tempo Traveller for a bachelor party. The driver handled our loud group with a smile and made sure we reached our destinations safely every night. Transparent pricing with no surprises at the end!"</p>
        <div class="user-info">
            <div class="avatar" style="background-color: #f99b28;">D</div>
            <div class="user-details">
                <span class="user-name">David Miller</span>
                <span class="user-location">Melbourne, Australia</span>
            </div>
        </div>
        <hr class="divider">
        <div class="tag">Group Tour</div>
    </div>

    <!-- Card 5 -->
    <div class="review-card">
        <div class="stars">★★★★★</div>
        <p class="review-text">"Punctual and professional. I travel to Goa frequently for work and always use their services for airport drop-offs. Always on time, clean cars, and courteous drivers, even for my 4 AM flights. Highly dependable."</p>
        <div class="user-info">
            <div class="avatar" style="background-color: #f99b28;">R</div>
            <div class="user-details">
                <span class="user-name">Rohan Desai</span>
                <span class="user-location">Pune, India</span>
            </div>
        </div>
        <hr class="divider">
        <div class="tag">Business Trip</div>
    </div>

    <!-- Card 6 -->
    <div class="review-card">
        <div class="stars">★★★★★</div>
        <p class="review-text">"Fantastic day exploring the spice plantations and Dudhsagar waterfalls! Our driver acted as a great guide, pointing out interesting spots along the way. The vehicle was well-maintained and air-conditioned, which was a blessing."</p>
        <div class="user-info">
            <div class="avatar" style="background-color: #f99b28;">E</div>
            <div class="user-details">
                <span class="user-name">Elena Rodriguez</span>
                <span class="user-location">Madrid, Spain</span>
            </div>
        </div>
        <hr class="divider">
        <div class="tag">Sightseeing Tour</div>
    </div>

    <!-- Card 7 -->
    <div class="review-card">
        <div class="stars">★★★★<span class="empty-star">★</span></div>
        <p class="review-text">"Good overall experience. The booking process was simple and the driver was friendly. We got stuck in some heavy traffic near Panjim, which delayed us, but the driver navigated it as best as he could. Will use again."</p>
        <div class="user-info">
            <div class="avatar" style="background-color: #f99b28;">M</div>
            <div class="user-details">
                <span class="user-name">Mark Thompson</span>
                <span class="user-location">Toronto, Canada</span>
            </div>
        </div>
        <hr class="divider">
        <div class="tag">Taxi Booking</div>
    </div>

    <!-- Card 8 -->
    <div class="review-card">
        <div class="stars">★★★★★</div>
        <p class="review-text">"Absolute lifesavers! We had a last-minute cancellation from another company and they accommodated us within an hour via a quick WhatsApp text. Clean car, great AC, and a very safe driver."</p>
        <div class="user-info">
            <div class="avatar" style="background-color: #f99b28;">A</div>
            <div class="user-details">
                <span class="user-name">Aisha Khan</span>
                <span class="user-location">Dubai, UAE</span>
            </div>
        </div>
        <hr class="divider">
        <div class="tag">Emergency Booking</div>
    </div>

    <!-- Card 9 -->
    <div class="review-card">
        <div class="stars">★★★★★</div>
        <p class="review-text">"Best taxi service in Goa! We used them for a week to beach-hop across North Goa. The driver was always ready when we needed him and gave us great tips on less crowded beaches and local shacks."</p>
        <div class="user-info">
            <div class="avatar" style="background-color: #f99b28;">L</div>
            <div class="user-details">
                <span class="user-name">Liam O'Connor</span>
                <span class="user-location">Dublin, Ireland</span>
            </div>
        </div>
        <hr class="divider">
        <div class="tag">Beach Tour</div>
    </div>

    <!-- Card 10 -->
    <div class="review-card">
        <div class="stars">★★★★★</div>
        <p class="review-text">"As a solo female traveler, safety was my top priority. I felt completely at ease with my driver throughout my 4-day trip. He was respectful, professional, and always waited until I was safely inside my hotel before leaving."</p>
        <div class="user-info">
            <div class="avatar" style="background-color: #f99b28;">C</div>
            <div class="user-details">
                <span class="user-name">Chloe Smith</span>
                <span class="user-location">New York, USA</span>
            </div>
        </div>
        <hr class="divider">
        <div class="tag">Solo Travel</div>
    </div>

    <!-- Card 11 -->
    <div class="review-card">
        <div class="stars">★★★★★</div>
        <p class="review-text">"We booked an Ertiga for our family of 5. The car was incredibly spacious and had plenty of room for all our luggage. The driver even helped us load and unload our heavy bags. Excellent customer service from start to finish."</p>
        <div class="user-info">
            <div class="avatar" style="background-color: #f99b28;">S</div>
            <div class="user-details">
                <span class="user-name">Sanjay Gupta</span>
                <span class="user-location">Hyderabad, India</span>
            </div>
        </div>
        <hr class="divider">
        <div class="tag">Family Trip</div>
    </div>

    <!-- Card 12 -->
    <div class="review-card">
        <div class="stars">★★★★<span class="empty-star">★</span></div>
        <p class="review-text">"Smooth ride from Dabolim airport to our resort in Palolem. The driver was waiting with a name sign, making it easy to find him. A bit pricier than local cabs outside, but the peace of mind and comfort were worth it."</p>
        <div class="user-info">
            <div class="avatar" style="background-color: #f99b28;">T</div>
            <div class="user-details">
                <span class="user-name">Thomas Weber</span>
                <span class="user-location">Berlin, Germany</span>
            </div>
        </div>
        <hr class="divider">
        <div class="tag">Airport Transfer</div>
    </div>
</div>




