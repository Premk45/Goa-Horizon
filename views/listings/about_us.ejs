<% layout("/layouts/boilerplate") %>

<div class="about-header-banner">
    <div class="banner-content">
        <span class="subtitle">Who We Are</span>
        <h1 class="main-title">About Goa Horizon Travels</h1>
        <p class="descriptiona">
            Your trusted travel partner in Goa. We make every journey comfortable, safe, and memorable.
        </p>
    </div>
</div>


<div class="our-story-section">
  <h2 class="heading">Our Story</h2>
  
  <div class="story-content">
    <p>
      Goa Horizon Travels was built to offer reliable, comfortable, and affordable travel across Goa. 
      Whether you need an airport pickup, a full-day North or South Goa tour, or a taxi for the day, we are 
      here to help.
    </p>
    
    <p>
      We work with a team of local drivers who know Goa inside out—from the best beaches and forts to 
      hidden spots and restaurants. Our vehicles are well-maintained and air-conditioned, and we take 
      pride in transparent service with no hidden charges.
    </p>
    
    <p>
      We serve individuals, families, and groups. Book via WhatsApp or email, and we’ll confirm your ride 
      or tour quickly. Thank you for choosing Goa Horizon Travels.
    </p>
  </div>
</div>

<section class="values-section">
  <span class="values-subtitle">WHAT WE STAND FOR</span>
  <h2 class="values-title">Our Values</h2>

  <div class="values-grid">
    
    <!-- Card 1: Safety First -->
    <div class="value-card">
      <div class="icon-circle">
        <!-- Shield Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#25a5d8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <h3>Safety First</h3>
      <p>Well-maintained vehicles and verified drivers for every trip.</p>
    </div>

    <!-- Card 2: Punctuality -->
    <div class="value-card">
      <div class="icon-circle">
        <!-- Clock Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#25a5d8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <h3>Punctuality</h3>
      <p>We value your time and ensure timely pickups and drop-offs.</p>
    </div>

    <!-- Card 3: Local Knowledge -->
    <div class="value-card">
      <div class="icon-circle">
        <!-- Map Pin Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#25a5d8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      </div>
      <h3>Local Knowledge</h3>
      <p>Expert drivers who know every corner of Goa and its best spots.</p>
    </div>

    <!-- Card 4: Customer Care -->
    <div class="value-card">
      <div class="icon-circle">
        <!-- Heart Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#25a5d8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      </div>
      <h3>Customer Care</h3>
      <p>Comfortable, affordable travel for individuals, families, and groups.</p>
    </div>

  </div>
</section>


<section class="cta-banner">
  <div class="cta-container">
    
    <!-- Car SVG Icon -->
    <div class="cta-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.5 2.8C2.0 11.2 2 11.6 2 12v4c0 .6.4 1 1 1h2"/>
        <circle cx="7" cy="17" r="2"/>
        <path d="M9 17h6"/>
        <circle cx="17" cy="17" r="2"/>
      </svg>
    </div>

    <!-- Title & Description -->
    <h2 class="cta-title">Ready to Travel with Us?</h2>
    <p class="cta-description">
      Book a taxi, airport transfer, or a North or South Goa tour. We're just a message away.
    </p>

    <!-- Buttons -->
    <div class="cta-buttons">
      <a href="/listings/booknow" class="btn_about btn_white">Book Now</a>
      <a href="/listings/contact" class="btn_about btn_outline">Contact Us</a>
    </div>

  </div>
</section>