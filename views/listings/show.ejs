<% layout("/layouts/boilerplate.ejs") %>

<div class="tour-card " style="background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('<%= listing.Image.url %>');">
    <div class="card-content">
        
        <div class="card-top">
            <span class="tagline">Full Day Tour</span>
            <h2 class="title"> <%= listing.Title %> </h2>
            <p class="description">
               <%= listing.Description %>
            </p>
        </div>

        <div class="card-bottom">
            
            <div class="badges-container">
                <div class="badge">
                    <span class="badge-label">Duration</span>
                    <div class="badge-value">
                        <span class="material-icons">schedule</span>
                        8-9 Hours
                    </div>
                </div>
                
                <div class="badge">
                    <span class="badge-label">Full day tour</span>
                    <div class="badge-value">
                        Contact us for fare
                    </div>
                </div>
            </div>

            <a href="https://wa.me/91XXXXXXXXXX" target="_blank" class="whatsapp-btn">
                <svg viewBox="0 0 24 24">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397 0 11.973 0c3.184.001 6.177 1.242 8.426 3.496 2.248 2.254 3.487 5.251 3.486 8.439-.004 6.625-5.34 11.97-11.918 11.97-2.004-.001-3.973-.505-5.724-1.467L0 24zm6.59-4.846c1.6.95 3.488 1.449 5.412 1.451 5.428 0 9.846-4.415 9.849-9.84.002-2.628-1.023-5.097-2.887-6.963C17.158 1.882 14.69 .854 12.06.854c-5.429 0-9.85 4.414-9.853 9.84-.001 1.984.518 3.921 1.508 5.645l-.99 3.618 3.702-.971c1.574.859 3.35 1.311 5.145 1.312zm9.967-6.898c-.27-.135-1.594-.786-1.84-.876-.246-.09-.426-.135-.606.135-.18.27-.696.876-.853 1.057-.158.18-.315.203-.586.067-.27-.135-1.138-.42-2.167-1.34-.801-.715-1.342-1.597-1.499-1.867-.158-.27-.017-.417.118-.552.121-.122.27-.315.405-.473.135-.158.18-.27.27-.45.09-.18.045-.338-.023-.473-.068-.135-.606-1.459-.83-2l-.546-1.323c-.218-.53-.446-.531-.606-.539-.158-.008-.338-.011-.518-.011s-.473.067-.72.338c-.246.27-.944.923-.944 2.25s.967 2.61 1.102 2.79c.135.18 1.902 2.904 4.609 4.073.644.278 1.147.444 1.54.569.647.206 1.237.177 1.702.107.518-.078 1.594-.652 1.819-1.283.225-.63.225-1.17.157-1.283-.067-.113-.247-.18-.517-.315z"/>
                </svg>
                <span>Book via WhatsApp</span>
            </a>

        </div>
    </div>
</div>




<div class="container">
    <div class="left-column">
        <!-- //route -->
        <div class="route-card">
            <h2 class="route-title">North Goa Special Beach Route</h2>
            <p class="route-subtitle">Optional extended coastal route that can be done as a separate day tour.</p>
            
            <ul class="route-list">
                <li class="route-item">
                    <span class="route-number">1.</span> Arambol Beach
                </li>
                <li class="route-item">
                    <span class="route-number">2.</span> Morjim Beach
                </li>
                <li class="route-item">
                    <span class="route-number">3.</span> Ashwem Beach
                </li>
                <li class="route-item">
                    <span class="route-number">4.</span> Chapora Fort & View Point
                </li>
            </ul>
        </div>

        <h2 class="section-title">Sample Day Plan (Fully Flexible)</h2>
        <div class="timeline">
            <div class="timeline-item">
                <div class="time">9:00 AM</div>
                <div class="location">Pickup from your hotel</div>
            </div>
            <div class="timeline-item">
                <div class="time">9:30 AM</div>
                <div class="location">Fort Aguada</div>
            </div>
            <div class="timeline-item">
                <div class="time">11:00 AM</div>
                <div class="location">Dolphin Trip</div>
            </div>
            <div class="timeline-item">
                <div class="time">12:00 PM</div>
                <div class="location">Calangute Beach</div>
            </div>
            <div class="timeline-item">
                <div class="time">1:00 PM</div>
                <div class="location">Baga Beach</div>
            </div>
            <div class="timeline-item">
                <div class="time">2:30 PM</div>
                <div class="location">Wax Museum</div>
            </div>
            <div class="timeline-item">
                <div class="time">3:30 PM</div>
                <div class="location">Snow Park</div>
            </div>
            <div class="timeline-item">
                <div class="time">4:30 PM</div>
                <div class="location">Anjuna Beach</div>
            </div>
            <div class="timeline-item">
                <div class="time">5:30 PM</div>
                <div class="location">Vagator Beach</div>
            </div>
            <div class="timeline-item">
                <div class="time">6:30 PM</div>
                <div class="location">Drop back to hotel</div>
            </div>
        </div>
    </div>

    

    <div class="right-column">
        <div class="booking-card">
            <h3 class="booking-title">Book North Goa Tour</h3>
            <p class="booking-subtitle">Fill in the details below. Send your booking via WhatsApp or Email and we'll confirm shortly.</p>
            
            <form>
                <div class="form-row">
                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" placeholder="Your name">
                    </div>
                    <div class="form-group">
                        <label>Phone Number</label>
                        <input type="tel" value="+91 96321 90350">
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Email (optional, for booking confirmation)</label>
                    <input type="email" placeholder="your@email.com">
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>Pickup Location</label>
                        <input type="text" placeholder="Enter pickup location">
                    </div>
                    <div class="form-group">
                        <label>Date</label>
                        <input type="date">
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>Time</label>
                        <input type="time">
                    </div>
                    <div class="form-group">
                        <label>Passengers</label>
                        <select>
                            <option>1 Passenger</option>
                            <option selected>2 Passengers</option>
                            <option>3 Passengers</option>
                            <option>4 Passengers</option>
                        </select>
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Vehicle Type</label>
                    <select>
                        <option selected>Sedan (4 Seater)</option>
                        <option>SUV (6 Seater)</option>
                    </select>
                </div>
                
                <div class="btn-group">
                    <button type="button" class="btn btn-whatsapp">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c-.003 1.396.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c.003-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.004-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/></svg>
                        Book via WhatsApp
                    </button>
                    <button type="button" class="btn btn-email">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/></svg>
                        Send via Email
                    </button>
                </div>
                <p class="call-text">Or call us at +91 96321 90350</p>
            </form>
        </div>
    </div>
</div>

<!-- Included Card -->
<div class="included-card">
    <h3 class="card-title">What's Included</h3>
    
    <ul class="included-list">
        <li class="included-item">
            <span class="checkmark-icon">
                <!-- SVG matching the circular double-ring green checkmark -->
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:100%; height:100%;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="16 9 11 14 8 11"></polyline>
                </svg>
            </span>
            AC vehicle (Sedan/SUV based on booking)
        </li>
        
        <li class="included-item">
            <span class="checkmark-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:100%; height:100%;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="16 9 11 14 8 11"></polyline>
                </svg>
            </span>
            Experienced local driver guide
        </li>
        
        <li class="included-item">
            <span class="checkmark-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:100%; height:100%;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="16 9 11 14 8 11"></polyline>
                </svg>
            </span>
            Hotel pickup and drop
        </li>
        
        <li class="included-item">
            <span class="checkmark-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:100%; height:100%;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="16 9 11 14 8 11"></polyline>
                </svg>
            </span>
            Toll and parking charges
        </li>
        
        <li class="included-item">
            <span class="checkmark-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:100%; height:100%;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="16 9 11 14 8 11"></polyline>
                </svg>
            </span>
            Driver allowance
        </li>
        
        <li class="included-item">
            <span class="checkmark-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:100%; height:100%;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="16 9 11 14 8 11"></polyline>
                </svg>
            </span>
            Water bottles
        </li>
    </ul>
</div>


<div class="editbtn">
    <div>
        <a href="/listings/<%= listing.id %>/edit">Edit</a>
    </div>
    <form method="POST" action="/listings/<%= listing.id %>?_method=DELETE">
        <div>
            <button>Delete</button>
        </div>
    </form>
</div>



   